# Copy this file to .env for local testing, and set these same variables
# in the Render dashboard for your live service.
# IMPORTANT: set them directly on the service. Service-level variables
# shadow env groups, and restarting the service does not reload them —
# always click "Save changes" and let Render redeploy.

# Your Neon Postgres connection string (Settings -> Connection string).
# Looks like: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# A long random string for signing login tokens.
JWT_SECRET=

# From Paystack dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx

# From Brevo (https://app.brevo.com) -> SMTP & API -> API keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@yourdomain.com
BREVO_SENDER_NAME=Igbo Mastery

# Your live Netlify site address, e.g. https://igbo-mastery.netlify.app
FRONTEND_ORIGIN=http://localhost:5000

# Local dev port
PORT=5000
